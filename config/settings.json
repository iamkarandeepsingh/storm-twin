{
  "_readme": "Settings, paths and discovered rule thresholds. API key goes in FLEET_API_KEY, never here.",
  "api_base_url": "https://storm-hackathon.vercel.app/api/v1",
  "api_key_env": "FLEET_API_KEY",
  "data_dir": "data",
  "page_size": 1000,
  "entities": [
    "Yard",
    "Vehicle",
    "Device",
    "DeviceAssignment",
    "Driver",
    "Route",
    "StatusData",
    "FaultData",
    "ExceptionEvent",
    "Trip",
    "DutyStatusLog",
    "Callout",
    "DispatchAssignment",
    "DispatchPlan",
    "WorkOrder"
  ],
  "raw_dir": "data/raw",
  "timezone": "America/Toronto",
  "rules": {
    "_source": "Discovered from last winter (see PERSONA.md and `python -m stormtwin backtest`).",
    "no_start": [
      {
        "name": "weak battery + cold start",
        "all": [
          {
            "feature": "battery_v_latest",
            "op": "<=",
            "value": 12.24
          },
          {
            "feature": "weather_min_temp_c",
            "op": "<=",
            "value": -10.5
          }
        ]
      }
    ],
    "hydraulic": [
      {
        "name": "hydraulics overdue + heavy snow",
        "all": [
          {
            "feature": "pto_since_hyd_service",
            "op": ">=",
            "value": 181.0
          },
          {
            "feature": "weather_snow_cm",
            "op": ">=",
            "value": 8.0
          }
        ]
      }
    ]
  },
  "weather_dir": "data/weather",
  "tonight": {
    "callout_local": "2026-12-16T02:00:00",
    "weather_file": "config/weather/tonight.json"
  },
  "watch_margins": {
    "battery_v": 12.3,
    "pto_since_hyd_service": 170
  },
  "actions": {
    "no_start": "REPAIR FIRST: replace/charge batteries before callout, else hold",
    "hydraulic": "REPAIR FIRST: hydraulic service before callout, else hold (will fail mid-route)",
    "watch": "DEPLOY, inspect first: near a failure threshold",
    "ok": "DEPLOY"
  },
  "ui_presets": [
    {
      "name": "4:30 pm bulletin (-14 C, 20 cm, callout 02:00)",
      "weather_file": "config/weather/tonight.json"
    },
    {
      "name": "9:30 pm update (-19 C, 27.5 cm, callout 00:30)",
      "weather_file": "config/weather/update_2130.json"
    }
  ],
  "_replay_missing_weather": "'warn' (default): write output, warn on stderr, weather-dependent rules cannot fire. 'error': exit 2, no output file (the replay would score 0 in the judges' re-run).",
  "replay_missing_weather": "warn"
}