{
  "_readme": "Settings, paths and discovered rule thresholds. API key goes in FLEET_API_KEY, never here.",
  "api_base_url": "https://storm-hackathon.vercel.app/api/v1",
  "api_key_env": "FLEET_API_KEY",
  "data_dir": "data",
  "page_size": 1000,
  "entities": [
    "Yard",
    "Vehicle",
    "Device",
    "DeviceAssignment",
    "Driver",
    "Route",
    "StatusData",
    "FaultData",
    "ExceptionEvent",
    "Trip",
    "DutyStatusLog",
    "Callout",
    "DispatchAssignment",
    "DispatchPlan",
    "WorkOrder"
